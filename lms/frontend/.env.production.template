# ===================================================================
# School LMS — Frontend .env.production.template (Next.js)
# Copy to .env, fill real values, NEVER commit secrets to VCS.
# All vars prefixed with NEXT_PUBLIC_ are exposed to client bundle.
# ===================================================================

# -- Supabase (Required) -------------------------------------------------
# Description: Supabase project URL for client-side auth & DB access.
# Type: string (URL)
# Required: YES
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Description: Supabase anon/public key (safe for client).
# Type: string
# Required: YES
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- API / Backend (Optional) --------------------------------------------
# Description: Backend API base URL for proxied requests. Defaults to '/api'.
# Type: string (URL)
# Optional: YES (defaults to /api — set full URL if separate domain)
# NEXT_PUBLIC_API_BASE_URL=https://api.school-lms.com

# Description: Canonical deployment URL (for SEO <head> / sitemap).
# Type: string (URL)
# Optional: YES (defaults to https://genesis.app)
# NEXT_PUBLIC_BASE_URL=https://your-school-lms.vercel.app

# -- Cloudinary (Required for uploads) -----------------------------------
# Description: Cloudinary unsigned upload preset name.
# Type: string
# Required: YES (file upload breaks without this)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# -- Firebase / FCM (Optional — push notifications) ----------------------
# Description: Firebase Web API key.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...

# Description: Firebase Auth domain.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Description: Firebase project ID.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# Description: Firebase Cloud Storage bucket.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Description: Firebase Cloud Messaging sender ID.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Description: Firebase Web App ID.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Description: Firebase measurement / analytics ID.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Description: Firebase VAPID key for push notification subscriptions.
# Type: string
# Optional: YES
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=BLQw...

# -- AI Model Selection (Optional) ---------------------------------------
# Description: Default OpenRouter model for AI features (chat, homework).
# Type: string
# Optional: YES (defaults to google/gemini-2.0-flash-001:free)
# NEXT_PUBLIC_OPENROUTER_MODEL=google/gemini-2.0-flash-001:free

# -- Monitoring (Optional) -----------------------------------------------
# Description: Sentry DSN for frontend error tracking.
# Type: string (URL)
# Optional: YES
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.us.sentry.io/123456
