# ===================================================================
# School LMS — Frontend .env.production.template (Vite)
# Copy to .env, fill real values, NEVER commit secrets to VCS.
# All vars prefixed with VITE_ are exposed to client bundle.
# ===================================================================

# -- Supabase (Required) -------------------------------------------------
# Description: Supabase project URL for client-side auth & DB access.
# Type: string (URL)
# Required: YES
VITE_SUPABASE_URL=https://your-project.supabase.co

# Description: Supabase anon/public key (safe for client).
# Type: string
# Required: YES
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- API / Backend (Optional) --------------------------------------------
# Description: Backend API base URL for proxied requests. Defaults to '/api'.
# Type: string (URL)
# Optional: YES (defaults to /api — set full URL if separate domain)
# VITE_API_BASE_URL=https://api.school-lms.com

# Description: Canonical deployment URL (for SEO <head> / sitemap).
# Type: string (URL)
# Optional: YES (defaults to https://genesis.app)
# VITE_BASE_URL=https://your-school-lms.vercel.app

# -- Cloudinary (Required for uploads) -----------------------------------
# Description: Cloudinary cloud name for image uploads.
# Type: string
# Required: YES (file upload breaks without this)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Description: Cloudinary unsigned upload preset name.
# Type: string
# Required: YES (file upload breaks without this)
# VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# -- Firebase / FCM (Optional — push notifications) ----------------------
# Description: Firebase Web API key.
# Type: string
# Optional: YES
# VITE_FIREBASE_API_KEY=AIzaSy...

# Description: Firebase Auth domain.
# Type: string
# Optional: YES
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Description: Firebase project ID.
# Type: string
# Optional: YES
# VITE_FIREBASE_PROJECT_ID=your-project

# Description: Firebase Cloud Storage bucket.
# Type: string
# Optional: YES
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Description: Firebase Cloud Messaging sender ID.
# Type: string
# Optional: YES
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Description: Firebase Web App ID.
# Type: string
# Optional: YES
# VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# Description: Firebase measurement / analytics ID.
# Type: string
# Optional: YES
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Description: Firebase VAPID key for push notification subscriptions.
# Type: string
# Optional: YES
# VITE_FIREBASE_VAPID_KEY=BLQw...

# -- AI Model Selection (Optional) ---------------------------------------
# Description: Default OpenRouter model for AI features (chat, homework).
# Type: string
# Optional: YES (defaults to google/gemini-2.0-flash-001:free)
# VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-001:free

# Description: OpenRouter model override for OCR/extraction step.
# Type: string
# Optional: YES (falls back to VITE_OPENROUTER_MODEL)
# VITE_OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini

# Description: OpenRouter model override for content generation step.
# Type: string
# Optional: YES (falls back to VITE_OPENROUTER_MODEL)
# VITE_OPENROUTER_MODEL_CONTENT=openai/gpt-4o-mini

# Description: OpenRouter model override for question generation step.
# Type: string
# Optional: YES (falls back to VITE_OPENROUTER_MODEL)
# VITE_OPENROUTER_MODEL_QUESTION=openai/gpt-4o-mini

# -- Monitoring (Optional) -----------------------------------------------
# Description: Sentry DSN for frontend error tracking.
# Type: string (URL)
# Optional: YES
# VITE_SENTRY_DSN=https://your-sentry-dsn.ingest.us.sentry.io/123456
