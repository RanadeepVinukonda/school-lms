rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the user has a specific role from their Firestore doc
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getRole() == 'admin' || getRole() == 'super_admin';
    }
    function isTeacher() {
      return getRole() == 'teacher';
    }
    function isStudent() {
      return getRole() == 'student';
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Users collection ---
    // Admins can read/write all. Users can read their own doc.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId) || isTeacher();
      allow write: if isAdmin() || isOwner(userId);
    }

    // --- Subjects collection ---
    // Anyone authenticated can read
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Classes collection ---
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Enrollment collection ---
    // Students can read their own enrollments, teachers/admins can read all
    match /enrollment/{enrollmentId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    // --- Grades collection ---
    match /grades/{gradeId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    // --- Assignments collection ---
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Submissions collection ---
    match /submissions/{submissionId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent();
      allow update: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- Exams collection ---
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Exam attempts collection ---
    match /examAttempts/{attemptId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent();
      allow update: if isStudent() || isTeacher();
      allow delete: if isAdmin();
    }

    // --- Corrections collection ---
    match /corrections/{correctionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Quizzes collection ---
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Timetable collection ---
    match /timetable/{timetableId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Notifications collection ---
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    // --- Lessons collection ---
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Textbook collections ---
    match /textbooks/{textbookId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /chapters/{chapterId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /concepts/{conceptId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    match /conceptProgress/{docId} {
      allow read: if isAdmin() || isTeacher() || (isStudent() && resource.data.userId == request.auth.uid);
      allow create: if isStudent();
      allow write: if isAdmin() || isTeacher();
    }

    match /conceptReleases/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
  }
}
