rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function uid() { return request.auth.uid; }
    function isStudent() { return isAuth() && role() == 'student'; }
    function isTeacher() { return isAuth() && role() == 'teacher'; }
    function isAdmin() { return isAuth() && role() == 'admin'; }
    function isSuperAdmin() { return isAuth() && role() == 'super_admin'; }
    function isAtLeastTeacher() { return isAuth() && (role() in ['teacher', 'admin', 'super_admin']); }
    function isAtLeastAdmin() { return isAuth() && (role() in ['admin', 'super_admin']); }
    function isSelf(userId) { return isAuth() && uid() == userId; }
    function getCourseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }
    function isCourseTeacher(courseId) {
      return isAuth() && getCourseData(courseId).teacherId == uid();
    }
    function isEnrolledIn(courseId) {
      return isAuth() && exists(
        /databases/$(database)/documents/enrollments/$(courseId + '_' + uid())
      );
    }

    match /schools/{schoolId} {
      allow read: if isAuth();
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuth() && (isSelf(userId) || isAtLeastAdmin());
      allow create: if isAtLeastAdmin();
      allow update: if isAuth() && (
        (isSelf(userId) && request.resource.data.role == resource.data.role) ||
        isAtLeastAdmin()
      );
      allow delete: if isAtLeastAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAuth();
      allow create, update, delete: if isAtLeastAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuth();
      allow create, update, delete: if isAtLeastAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isEnrolledIn(courseId));
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher() && (
        (isTeacher() && resource.data.teacherId == uid()) || isAtLeastAdmin()
      );
      allow delete: if isAtLeastAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isSelf(enrollmentId.split('_')[1]));
      allow create: if isAtLeastTeacher();
      allow update, delete: if isAtLeastAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isEnrolledIn(getCourseData(resource.data.courseId).teacherId));
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isEnrolledIn(resource.data.courseId));
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAuth() && (isSelf(resource.data.studentId) || isAtLeastTeacher());
      allow create: if isAuth() && isStudent() && request.resource.data.studentId == uid();
      allow update: if isAuth() && (isSelf(resource.data.studentId) || isAtLeastTeacher());
      allow delete: if isAtLeastAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isEnrolledIn(resource.data.courseId));
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /attempts/{attemptId} {
      allow read: if isAuth() && (isSelf(resource.data.studentId) || isAtLeastTeacher());
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isStudent() && resource.data.studentId == uid();
      allow delete: if false;
    }

    match /exams/{examId} {
      allow read: if isAuth() && (isAtLeastTeacher() || isEnrolledIn(resource.data.courseId));
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /examAttempts/{attemptId} {
      allow read: if isAuth() && (isSelf(resource.data.studentId) || isAtLeastTeacher());
      allow create: if isStudent() && request.resource.data.studentId == uid();
      allow update: if isStudent() && resource.data.studentId == uid();
      allow delete: if false;
    }

    match /grades/{gradeId} {
      allow read: if isAuth() && (isSelf(resource.data.studentId) || isAtLeastTeacher());
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create: if isAtLeastTeacher();
      allow update: if isAtLeastTeacher();
      allow delete: if isAtLeastAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAuth() && (resource.data.participantIds.hasAny([uid()]) || isAtLeastAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.participantIds.hasAny([uid()]);
      allow delete: if isAtLeastAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAuth() && (resource.data.senderId == uid() || resource.data.recipientIds.hasAny([uid()]));
      allow create: if isAuth() && request.resource.data.senderId == uid();
      allow update: if isAuth() && resource.data.senderId == uid();
      allow delete: if isAtLeastAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.recipientId == uid();
      allow create: if false;
      allow update: if isAuth() && resource.data.recipientId == uid();
      allow delete: if isAuth() && resource.data.recipientId == uid();
    }

    match /files/{fileId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.uploadedBy == uid() || isAtLeastAdmin());
      allow delete: if isAtLeastAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAtLeastAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAtLeastAdmin();
      allow write: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isAuth() && (resource.data.userId == uid() || isAtLeastAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
