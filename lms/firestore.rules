rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get role from auth token claims (set by backend) or fall back to Firestore doc
    function getRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getRole() == 'admin' || getRole() == 'super_admin';
    }
    function isTeacher() {
      return getRole() == 'teacher';
    }
    function isStudent() {
      return getRole() == 'student';
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Users collection ---
    // Users can read their own doc; admins/teachers can read all (for class rosters etc.).
    // Password hashes must never be exposed — only store them via backend Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isTeacher();
      allow write: if isOwner(userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'phone', 'classIds']);
    }

    // --- Subjects collection ---
    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Classes collection ---
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Enrollment collection ---
    match /enrollment/{enrollmentId} {
      allow read: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow write: if isAdmin() || isTeacher();
    }

    // --- Grades collection ---
    match /grades/{gradeId} {
      allow read: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow write: if isAdmin() || isTeacher();
    }

    // --- Assignments collection ---
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Submissions collection ---
    match /submissions/{submissionId} {
      allow read: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow create: if isStudent();
      allow update: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // --- Exams collection ---
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Exam attempts collection ---
    match /examAttempts/{attemptId} {
      allow read: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow create: if isStudent();
      allow update: if isStudent() || isTeacher();
      allow delete: if isAdmin();
    }

    // --- Corrections collection ---
    match /corrections/{correctionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Quizzes collection ---
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Timetable collection ---
    match /timetable/{timetableId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Notifications collection ---
    match /notifications/{notificationId} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isTeacher() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- Lessons collection ---
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Textbook collections (including subcollections) ---
    match /textbooks/{textbookId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /textbooks/{textbookId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /chapters/{chapterId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /concepts/{conceptId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    match /conceptProgress/{docId} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin() || isTeacher();
      allow create: if isStudent();
      allow write: if isAdmin() || isTeacher();
    }

    match /conceptReleases/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Courses collection ---
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    // --- Quiz attempts collection ---
    match /quizAttempts/{attemptId} {
      allow read: if resource.data.studentId == request.auth.uid || isAdmin() || isTeacher();
      allow create: if isStudent();
      allow update: if isStudent() || isTeacher();
      allow delete: if isAdmin();
    }

    // --- Conversations collection ---
    match /conversations/{conversationId} {
      allow read: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isAdmin();
    }

    // --- Messages collection ---
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // --- Activity logs collection ---
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Settings collection ---
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- Uploads collection ---
    match /uploads/{uploadId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isTeacher();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Tokens collection ---
    match /tokens/{tokenId} {
      allow read, write: if false; // system-only via backend admin SDK
    }

    // --- Audit logs collection ---
    // Append-only: admins can create, only super_admin can read
    match /auditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if getRole() == 'super_admin';
      allow update, delete: if false;
    }
    // --- Processing Jobs collection ---
    match /processingJobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }
  }
}
