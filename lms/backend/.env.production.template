# ===================================================================
# School LMS — Backend .env.production.template
# Copy to .env, fill real values, NEVER commit secrets to VCS.
# ===================================================================

# -- Server --------------------------------------------------------------
# Description: Node environment.
# Type: enum (development | production | test)
# Required: YES
NODE_ENV=production

# Description: Port the Express server listens on.
# Type: number (1–65535)
# Required: YES
PORT=3001

# Description: Origin URL of the frontend (for CORS, cookies, redirects).
# Type: string (URL)
# Required: YES
FRONTEND_URL=https://your-school-lms.vercel.app

# -- Supabase (Required) -------------------------------------------------
# Description: Supabase project URL.
# Type: string (URL)
# Required: YES
SUPABASE_URL=https://your-project.supabase.co

# Description: Supabase anon/public client key.
# Type: string
# Required: YES
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Description: Supabase service-role key (admin privileges — guard with care).
# Type: string
# Required: YES
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Description: Supabase storage bucket name for file uploads.
# Type: string
# Required: YES
SUPABASE_STORAGE_BUCKET=textbooks

# -- Supabase (Optional) -------------------------------------------------
# Description: Direct Postgres connection string (for migrations / advanced queries).
# Type: string (postgresql:// URI)
# Optional: YES
# DATABASE_URL=postgresql://user:password@db.xxxxx.supabase.co:6543/postgres

# Description: Supabase JWT secret for verifying auth tokens server-side.
# Type: string
# Optional: YES
# SUPABASE_JWT_SECRET=your-jwt-secret

# -- AI / LLM (Required) -------------------------------------------------
# Description: Google Gemini API key (used as primary AI provider + fallback for all AI calls).
# Type: string
# Required: YES
GEMINI_API_KEY=AIzaSy...

# Description: API key for OpenRouter or OpenAI-compatible provider (fallback path).
# Type: string
# Optional: YES (Gemini used when empty)
# AI_API_KEY=sk-or-...

# Description: Base URL for the OpenAI-compatible API endpoint.
# Type: string (URL)
# Optional: YES (defaults to OpenRouter)
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Description: Default AI model identifier.
# Type: string
# Optional: YES (defaults to openai/gpt-4o-mini)
AI_MODEL=openai/gpt-4o-mini

# -- AI Textbook (Optional overrides for OCR / textbook pipeline) --------
# Description: Separate API key for textbook/OCR tasks (falls back to GEMINI_API_KEY).
# Type: string
# Optional: YES
# AI_TEXTBOOK_API_KEY=sk-or-...

# Description: Separate base URL for textbook provider.
# Type: string (URL)
# Optional: YES (falls back to AI_BASE_URL)
# AI_TEXTBOOK_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Description: Separate model for textbook tasks.
# Type: string
# Optional: YES (falls back to AI_MODEL)
# AI_TEXTBOOK_MODEL=gemini-2.0-flash

# -- Cloudinary (Required) -----------------------------------------------
# Description: Cloudinary cloud name for image/file uploads.
# Type: string
# Required: YES
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Description: Cloudinary API key.
# Type: string
# Required: YES
CLOUDINARY_API_KEY=123456789012345

# Description: Cloudinary API secret.
# Type: string
# Required: YES
CLOUDINARY_API_SECRET=abc123def456

# -- SMTP / Email (Optional) ---------------------------------------------
# Description: SMTP server hostname.
# Type: string
# Optional: YES (email features disabled when unset)
# SMTP_HOST=smtp.gmail.com

# Description: SMTP server port.
# Type: number
# Optional: YES
# SMTP_PORT=587

# Description: SMTP username (often the email address).
# Type: string
# Optional: YES
# SMTP_USER=you@gmail.com

# Description: SMTP password or app-specific password.
# Type: string
# Optional: YES
# SMTP_PASS=your-app-password

# Description: From-address for outgoing emails.
# Type: string (email)
# Optional: YES
# SMTP_FROM=noreply@school-lms.com

# -- Rate Limiting -------------------------------------------------------
# Description: Max auth requests per window per IP (login, register, forgot-password).
# Type: number
# Optional: YES (defaults to 20)
AUTH_RATE_LIMIT_MAX=20

# Description: Auth rate-limit window in milliseconds.
# Type: number (ms)
# Optional: YES (defaults to 300000 = 5 min)
AUTH_RATE_LIMIT_WINDOW_MS=300000

# Description: Max general API requests per window per IP.
# Type: number
# Optional: YES (defaults to 100)
API_RATE_LIMIT_MAX=100

# Description: API rate-limit window in milliseconds.
# Type: number (ms)
# Optional: YES (defaults to 60000 = 1 min)
API_RATE_LIMIT_WINDOW_MS=60000

# -- Cookie / Session ----------------------------------------------------
# Description: Cookie domain override (set to your production domain).
# Type: string
# Optional: YES
# COOKIE_DOMAIN=.your-school-lms.com

# Description: Whether cookies require HTTPS (must be true in production).
# Type: boolean
# Optional: YES (defaults to false — SET TO true IN PRODUCTION)
COOKIE_SECURE=true

# -- Monitoring (Optional) -----------------------------------------------
# Description: Sentry DSN for error tracking.
# Type: string (URL)
# Optional: YES
# SENTRY_DSN=https://your-sentry-dsn.ingest.us.sentry.io/123456

# Description: Expo access token for EAS / push notification builds.
# Type: string
# Optional: YES
# EXPO_ACCESS_TOKEN=your-expo-token
