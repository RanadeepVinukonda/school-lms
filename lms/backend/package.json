{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "School LMS Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "seed": "tsx src/scripts/createTestUsers.ts",
    "seed:full": "tsx src/scripts/seedFull.ts",
    "seed:supplemental": "tsx src/scripts/seedSupplemental.ts",
    "seed:reset": "tsx src/scripts/cleanAll.ts && npm run seed:full && npm run seed:supplemental",
    "seed:all": "npm run seed:full && npm run seed:supplemental",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/pdfkit": "^0.17.6",
    "@xenova/transformers": "^2.0.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pg-boss": "^9.0.3",
    "prom-client": "^15.1.3",
    "speakeasy": "^2.0.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.0",
    "xss": "^1.0.15",
    "yt-search": "^2.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/yt-search": "^2.10.3",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
