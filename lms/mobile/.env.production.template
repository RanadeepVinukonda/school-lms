# ===================================================================
# School LMS — Mobile .env.production.template (Expo / EXPO_PUBLIC_*)
# Copy to student/.env, teacher/.env, or parent/.env per app.
# NEVER commit real values to VCS.
# Prefix EXPO_PUBLIC_ exposes the var to client JS bundles.
# ===================================================================

# -- Backend API ---------------------------------------------------------
# Description: URL of the production backend API server.
# Type: string (URL)
# Required: YES
EXPO_PUBLIC_API_URL=https://api.school-lms.com

# -- Supabase (Required) -------------------------------------------------
# Description: Supabase project URL for auth & DB.
# Type: string (URL)
# Required: YES
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Description: Supabase anon/public key (safe for client).
# Type: string
# Required: YES
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
