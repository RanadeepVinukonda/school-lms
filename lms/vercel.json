{
  "version": 2,
  "buildCommand": "cd backend && npx tsc && cd ../frontend && npm run build",
  "installCommand": "cd backend && npm ci && cd ../frontend && npm ci",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...slug]" },
    { "source": "/((?!api/|assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...slug].ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
