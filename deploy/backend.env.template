# ===================================================================
# Genesis LMS — Backend Cloud Server ENV TEMPLATE
# Frontend stays on Vercel; this file runs the API on your cloud box.
#
# COPY THIS FILE to  lms/backend/.env  ON YOUR SERVER ONLY.
# Replace every << ... >> with a real value. NEVER commit this file.
# Required keys are marked REQUIRED (backend refuses to boot without them).
# ===================================================================

# ---------------------------------------------------------------- #
# 1. SERVER / CORE
# ---------------------------------------------------------------- #
# REQUIRED  (enum: development | production | test)
NODE_ENV=production

# REQUIRED  container MUST listen on 4000 — the Docker HEALTHCHECK
# probes http://localhost:4000/health (Dockerfile line 21).
PORT=4000

# REQUIRED  exact origin of YOUR Vercel frontend (CORS allow-list).
# Also add it to cors.ts PRODUCTION_ORIGINS if it isn't already there.
FRONTEND_URL=https://genesis-frontend-teal.vercel.app

# REQUIRED in production — httpOnly cookies only sent over HTTPS.
COOKIE_SECURE=true

# OPTIONAL  e.g. .yourschool.com if frontend + API share a root domain.
# LEAVE EMPTY if API is on a different registrable domain than the site.
# COOKIE_DOMAIN=

# ---------------------------------------------------------------- #
# 2. SUPABASE  (REQUIRED — database of record)
# ---------------------------------------------------------------- #
SUPABASE_URL=https://<<your-project>>.supabase.co
SUPABASE_ANON_KEY=<<anon-public-key>>
SUPABASE_SERVICE_ROLE_KEY=<<service-role-key  (secret!)>>
SUPABASE_STORAGE_BUCKET=textbooks

# REQUIRED for /health + /health/deep + raw-SQL transactions
# (transaction-manager, advisory locks, fee/inventory/timetable).
# Use the Supabase TRANSACTION (session) pooler URI, NOT the API keyed string.
# Format:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<<ref>>:<<db-password>>@aws-0-<<region>>.pooler.supabase.com:6543/postgres

# OPTIONAL  connection pool size per backend instance (default 20).
# Keep <= 20 per instance; the Supabase pooler has a hard cap.
DATABASE_POOL_MAX=20

# OPTIONAL  only needed for custom JWT verification (usually not required).
# SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------- #
# 3. AI / LLM  (REQUIRED)
# ---------------------------------------------------------------- #
GEMINI_API_KEY=AIza<<...>>

# OPTIONAL  OpenRouter fallback provider.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# AI_MODEL=openai/gpt-4o-mini

# OPTIONAL  separate provider for the heavy textbook pipeline.
# AI_TEXTBOOK_API_KEY=
# AI_TEXTBOOK_BASE_URL=
# AI_TEXTBOOK_MODEL=

# ---------------------------------------------------------------- #
# 4. CLOUDINARY  (REQUIRED — file/image uploads)
# ---------------------------------------------------------------- #
CLOUDINARY_CLOUD_NAME=<<cloud-name>>
CLOUDINARY_API_KEY=<<api-key>>
CLOUDINARY_API_SECRET=<<api-secret  (secret!)>>

# ---------------------------------------------------------------- #
# 5. YOUTUBE  (recommended — enables reliable Khan Academy video search)
# ---------------------------------------------------------------- #
YOUTUBE_API_KEY=AIza<<...>>

# ---------------------------------------------------------------- #
# 6. SMTP / EMAIL  (optional — needed for password reset links etc.)
# ---------------------------------------------------------------- #
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<<sender-email>>
SMTP_PASS=<<gmail-app-password>>
SMTP_FROM=noreply@<<your-school>>.com

# ---------------------------------------------------------------- #
# 7. RATE LIMITING  (per-instance, in-memory store)
# ---------------------------------------------------------------- #
# NOTE: these are per-process. Don't go higher than needed; if you run
# multiple backend replicas the effective limit multiplies.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=300000
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------- #
# 8. MONITORING  (optional)
# ---------------------------------------------------------------- #
# SENTRY_DSN=https://<<...>>@ingest.sentry.io/<<project>>

# ---------------------------------------------------------------- #
# 9. CRON  (RECOMMENDED — guards /jobs/cron/* endpoints)
# If unset the cron endpoints are OPEN (no auth). Generate a strong value:
#   openssl rand -hex 32
CRON_SECRET=<<64-char-hex>>

# ---------------------------------------------------------------- #
# 10. INNGEST  (RECOMMENDED for the textbook pipeline in production)
# Without these, Inngest runs in DEV mode and long textbook uploads are
# processed inline in the same process (still works, but ties up the API).
# Get keys from https://app.inngest.com
# INNGEST_SIGNING_KEY=signkey-<<...>>
# INNGEST_EVENT_KEY=<<...>>

# ---------------------------------------------------------------- #
# 11. REDIS  (optional — NOT yet consumed by app code)
# The app currently uses in-memory caches (src/utils/cache.ts). Redis is a
# scaling enhancement: add src/utils/redis.ts + ioredis when you need a
# shared cache across replicas or a job queue. If you run the redis service
# in docker-compose, set this to the container name:
# REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------- #
# 12. LOGGING / SEARCH  (optional)
# ---------------------------------------------------------------- #
LOG_LEVEL=info
# Set VERCEL=1 to disable file logging (real server keeps file logs).
# VERCEL=0
# SEARCH_SERVICE_URL=http://localhost:4001
# GOOGLE_VISION_API_KEY=AIza<<...>>