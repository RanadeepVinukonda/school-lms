{
  "name": "Genesis",
  "slug": "genesis-webview",
  "version": "1.2.9",
  "orientation": "portrait",
  "icon": "./assets/genesis_icon.png",
  "userInterfaceStyle": "automatic",
  "splash": {
    "image": "./assets/genesis_icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#FAFAF5"
  },
  "assetBundlePatterns": ["**/*"],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.genesis.app",
    "infoPlist": {
      "NSCameraUsageDescription": "Genesis uses the camera to scan documents and take photos for uploads.",
      "NSPhotoLibraryUsageDescription": "Genesis needs access to your photos so you can upload images.",
      "NSMicrophoneUsageDescription": "Genesis uses the microphone for audio uploads."
    }
  },
  "android": {
    "package": "com.genesis.app",
    "adaptiveIcon": {
      "foregroundImage": "./assets/genesis_icon.png",
      "backgroundColor": "#FAFAF5"
    }
  },
  "owner": "chandhini2005s-team",
  "extra": {
    "eas": {
      "projectId": "d433cb58-3169-4b2f-ae58-e89c1887ab7d"
    }
  }
}
